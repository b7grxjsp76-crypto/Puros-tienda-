// tasa aproximada (puedes cambiarla o automatizar después)
const tasa = 950;

document.querySelectorAll(".precio").forEach(el => {
  const usd = el.dataset.usd;
  const clp = usd * tasa;

  el.nextElementSibling.innerText =
    "$" + clp.toLocaleString("es-CL") + " CLP";
});

